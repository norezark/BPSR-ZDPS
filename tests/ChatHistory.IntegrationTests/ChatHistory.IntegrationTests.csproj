<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../BPSR-ZDPSLib/BPSR-ZDPSLib.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <Compile Include="../../BPSR-ZDPS/AppPaths.cs" Link="Production/AppPaths.cs" />
    <Compile Include="../../BPSR-ZDPS/Managers/ChatManager.cs" Link="Production/ChatManager.cs" />
    <Compile Include="../../BPSR-ZDPS/DataTypes/Chat/*.cs" Link="Production/DataTypes/%(Filename)%(Extension)" />
    <Compile Include="../../BPSR-ZDPS/Features/ChatHistory/*.cs" Link="Production/History/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
